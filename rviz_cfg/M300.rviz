Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Registered scan
      Enabled: true
      Topic:
        Value: /cloud_registered
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: RGB8
      Color: 255; 190; 45
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Effective points
      Enabled: true
      Topic:
        Value: /cloud_effected
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: RGB8
      Color: 255; 190; 45
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR map
      Enabled: true
      Topic:
        Value: /Laser_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: RGB8
      Color: 255; 190; 45
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
